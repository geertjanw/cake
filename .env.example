# Copy this file to .env and fill in the two required values from Dash0.
# Everything here is read by docker-compose.yaml and scripts/run-local.sh.

# --- Required: your Dash0 credentials -----------------------------------
# Dash0 → Settings → Auth Tokens  (create an ingestion token)
DASH0_AUTH_TOKEN=

# Dash0 → Settings → Endpoints  (the OTLP/gRPC ingress for your region)
# Example: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.eu-west-1.aws.dash0.com:4317

# --- Optional --------------------------------------------------------------
# Dash0 dataset to write into (lets you keep demo data separate).
DASH0_DATASET=default

# Sets the deployment.environment resource attribute on all telemetry.
DEPLOYMENT_ENV=demo
